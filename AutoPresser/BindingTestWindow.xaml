<ui:FluentWindow x:Class="AutoPresser.BindingTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AutoPresser - Binding Test"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Height="500"
        Width="700"
        MinHeight="350"
        MinWidth="500"
        WindowBackdropType="None"
        KeyDown="Window_KeyDown"
        TextInput="Window_TextInput" Icon="Assets/AutoPresser.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Binding Test"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Click counter"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="ClickCountText"
                           Text="0"
                           FontSize="36"
                           HorizontalAlignment="Center"
                           Margin="0,8"/>

                <Button Content="Test Click Target"
                        Height="44"
                        Click="TestClickButton_Click"/>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="2"
                  Header="Binding Activity"
                  Padding="8">
            <ListBox x:Name="LogList"
                     FontFamily="Consolas"
                     FontSize="12"
                     HorizontalContentAlignment="Stretch"/>
        </GroupBox>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <CheckBox x:Name="DebugEnabledCheckBox"
                      Content="Debug output"
                      IsChecked="True"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0"
                      Checked="DebugEnabledCheckBox_Changed"
                      Unchecked="DebugEnabledCheckBox_Changed"/>

            <Button Content="Clear Log"
                    Padding="16,6"
                    Click="ClearLogButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>