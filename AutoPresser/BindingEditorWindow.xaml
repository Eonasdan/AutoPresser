<ui:FluentWindow x:Class="AutoPresser.BindingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Binding" Height="660" Width="560" MinHeight="620" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ResizeMode="CanResizeWithGrip"
        WindowBackdropType="None" Icon="Assets/AutoPresser.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeadingText" Text="Binding" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Choose a trigger and the action it should perform." Opacity="0.7" Margin="0,4,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Trigger hotkey" FontWeight="SemiBold" />
                <TextBox x:Name="TriggerKeyRecorder" Text="Click here, then press a key combination" IsReadOnly="True"
                         Margin="0,5,0,4" MinHeight="38" Padding="8,7" Cursor="Hand"
                         PreviewMouseLeftButtonDown="TriggerKeyRecorder_PreviewMouseLeftButtonDown"
                         PreviewKeyDown="TriggerKeyRecorder_PreviewKeyDown"
                         LostKeyboardFocus="TriggerKeyRecorder_LostKeyboardFocus" />
                <TextBlock Text="Click the field and press the key. Ctrl, Shift, Alt, and Windows modifiers are recorded automatically."
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock x:Name="TriggerRecorderHintText"
                           Text="Not listening. Click the field to record a trigger. Press Esc to cancel recording."
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Required modifiers (exact match)" FontWeight="SemiBold" />
                <WrapPanel Margin="0,5,0,14">
                    <CheckBox x:Name="ControlCheckBox" Content="Ctrl" IsHitTestVisible="False" Focusable="False" Margin="0,0,18,0" />
                    <CheckBox x:Name="ShiftCheckBox" Content="Shift" IsHitTestVisible="False" Focusable="False" Margin="0,0,18,0" />
                    <CheckBox x:Name="AltCheckBox" Content="Alt" IsHitTestVisible="False" Focusable="False" Margin="0,0,18,0" />
                    <CheckBox x:Name="WindowsCheckBox" Content="Windows" IsHitTestVisible="False" Focusable="False" />
                </WrapPanel>
                <TextBlock Text="Action" FontWeight="SemiBold" />
                <ComboBox x:Name="ActionComboBox" Margin="0,5,0,4" MinHeight="34" SelectionChanged="ActionComboBox_SelectionChanged" DisplayMemberPath="Display" SelectedValuePath="Value" />
                <TextBlock x:Name="ActionHelpText" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Target device" FontWeight="SemiBold" />
                <ComboBox x:Name="DeviceComboBox" Margin="0,5,0,12" MinHeight="34" SelectionChanged="DeviceComboBox_SelectionChanged" DisplayMemberPath="Display" SelectedValuePath="Value" />
                <StackPanel x:Name="MouseTargetPanel" Margin="0,0,0,12">
                    <TextBlock Text="Mouse button" FontWeight="SemiBold" />
                    <ComboBox x:Name="MouseButtonComboBox" Margin="0,5,0,0" MinHeight="34" DisplayMemberPath="Display" SelectedValuePath="Value" />
                </StackPanel>
                <StackPanel x:Name="KeyboardTargetPanel" Margin="0,0,0,12">
                    <TextBlock Text="Keyboard key" FontWeight="SemiBold" />
                    <TextBox x:Name="TargetKeyRecorder" Text="Click here, then press a key" IsReadOnly="True"
                             Margin="0,5,0,0" MinHeight="38" Padding="8,7" Cursor="Hand"
                             PreviewMouseLeftButtonDown="TargetKeyRecorder_PreviewMouseLeftButtonDown"
                             PreviewKeyDown="TargetKeyRecorder_PreviewKeyDown"
                             LostKeyboardFocus="TargetKeyRecorder_LostKeyboardFocus" />
                    <TextBlock x:Name="TargetRecorderHintText"
                               Text="Not listening. Click the field to record a target key. Press Esc to cancel recording."
                               Opacity="0.7" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
                <Grid x:Name="AutoClickOptionsPanel" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Interval (ms)" FontWeight="SemiBold" />
                        <TextBox x:Name="IntervalTextBox" Text="100" Margin="0,5,0,0" MinHeight="34" Padding="8,5" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Repeat count (0 = infinite)" FontWeight="SemiBold" />
                        <TextBox x:Name="RepeatCountTextBox" Text="0" Margin="0,5,0,0" MinHeight="34" Padding="8,5" />
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="EnabledCheckBox" Content="Binding enabled" IsChecked="True" Margin="0,0,0,12" />
                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,16,0,0">
            <ui:Button Content="Cancel" Click="CancelButton_Click" DockPanel.Dock="Right" Margin="8,0,0,0" />
            <ui:Button Content="Save Binding" Click="SaveButton_Click" DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
